{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixfied.dev/schemas/workflow-contract.json",
  "title": "Nixfied Workflow Contract",
  "type": "object",
  "required": [
    "id",
    "summary",
    "mode",
    "maxWorkers",
    "units",
    "stages",
    "execution"
  ],
  "properties": {
    "id": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [ "ci", "dev", "test", "build", "check", "format", "custom" ]
    },
    "maxWorkers": { "type": "integer", "minimum": 1 },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [ "taskId", "needs", "locks", "when", "skipIfMissingEnv" ]
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "setup": { "type": "object" },
    "teardown": { "type": "object" },
    "artifacts": { "type": "object" },
    "execution": { "type": "object" }
  },
  "additionalProperties": true
}
