{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixfied.dev/schemas/workflow-contract.json",
  "title": "Nixfied Workflow Contract",
  "type": "object",
  "required": [
    "id",
    "summary",
    "mode",
    "maxWorkers",
    "units",
    "stages",
    "preRun",
    "postRun",
    "artifacts",
    "execution"
  ],
  "properties": {
    "id": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [ "ci", "dev", "test", "build", "check", "format", "custom" ]
    },
    "maxWorkers": { "type": "integer", "minimum": 1 },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [ "taskId", "needs", "locks", "when", "skipIfMissingEnv" ],
        "properties": {
          "taskId": { "type": "string" },
          "needs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "locks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "when": { "type": "object" },
          "skipIfMissingEnv": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "services": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [ "postgres", "nginx", "minio", "reth", "helios" ]
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "levelDefault": {
          "type": [ "string", "null" ],
          "enum": [ "error", "warn", "info", "debug", "trace", null ]
        },
        "outputDefault": {
          "type": [ "string", "null" ],
          "enum": [ "stdout", "logs", "both", null ]
        }
      },
      "additionalProperties": true
    },
    "preRun": { "type": "object" },
    "postRun": { "type": "object" },
    "artifacts": { "type": "object" },
    "execution": {
      "type": "object",
      "properties": {
        "parallel": { "type": "boolean" },
        "failFast": { "type": "boolean" },
        "lockPolicy": { "type": "string", "enum": [ "exclusive", "shared-aware" ] },
        "emitRegistryEvents": { "type": "boolean" },
        "ephemeral": {
          "type": "object",
          "properties": {
            "enable": { "type": [ "boolean", "null" ] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
