  "query": "SELECT c.relname::text AS \"relation!\", con.conname AS \"name!\", con.contype::text AS \"kind!\", pg_get_constraintdef(con.oid, false) AS \"definition!\", con.convalidated AS \"validated!\" FROM pg_catalog.pg_constraint con JOIN pg_catalog.pg_class c ON c.oid = con.conrelid JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = $1 AND c.relname = ANY($2::text[])",
