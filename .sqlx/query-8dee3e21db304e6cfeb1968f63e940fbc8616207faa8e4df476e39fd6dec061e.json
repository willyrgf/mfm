  "query": "SELECT h.run_id, h.head_sequence, f.head_digest, h.total_bytes FROM ONLY public.mfm_run_heads h JOIN ONLY public.mfm_run_frames f ON f.run_id = h.run_id AND f.run_sequence = h.head_sequence WHERE h.run_id > $1 ORDER BY h.run_id COLLATE \"C\" LIMIT $2",
