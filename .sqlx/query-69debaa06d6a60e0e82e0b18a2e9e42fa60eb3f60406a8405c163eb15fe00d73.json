  "db_name": "PostgreSQL",
  "query": "SELECT NULL::text AS \"relation?\", NULL::text AS \"column?\", pg_get_userbyid(acl.grantor) AS \"grantor!\", CASE WHEN acl.grantee = 0 THEN 'PUBLIC' ELSE pg_get_userbyid(acl.grantee) END AS \"grantee!\", acl.privilege_type AS \"privilege!\", acl.is_grantable AS \"grant_option!\" FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL aclexplode( COALESCE(n.nspacl, acldefault('n'::\"char\", n.nspowner))) acl WHERE n.nspname = $1",
