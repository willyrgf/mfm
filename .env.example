# Example Ethereum mainnet RPC config for local development.
#
# Copy to `.env` (which is gitignored) and adjust as needed.

# Runtime-only EVM RPC bootstrap. Do not include URL/auth secrets in persisted configs.
MFM_EVM_RPC_SOURCES_JSON='[{"id":"publicnode_ethereum_mainnet","network_id":"ethereum-mainnet","rpc_url":"https://ethereum-rpc.publicnode.com","kind":"remote_public"}]'
MFM_EVM_RPC_PREFERRED_ORDER=publicnode_ethereum_mainnet

# Optional websocket endpoint (useful for subscription-based tools).
ETHEREUM_MAINNET_RPC_WSS=wss://ethereum-rpc.publicnode.com
