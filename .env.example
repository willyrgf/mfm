# Example Helios mainnet config for local development.
#
# Copy to `.env` (which is gitignored) and adjust as needed.

HELIOS_NETWORK=mainnet

# Upstream execution-layer JSON-RPC.
#
# NOTE: Helios needs an endpoint that supports `eth_getProof` for explicit numeric block params.
# Some free endpoints only support proofs at `latest` and will break deterministic/pinned queries.
HELIOS_EXECUTION_RPC_URL=https://eth.drpc.org

# Optional: upstream consensus endpoint (Beacon API).
# If omitted, the Nixfied Helios service defaults this for mainnet and will derive a checkpoint.
#HELIOS_CONSENSUS_RPC_URL=https://www.lightclientdata.org

# Optional: pinned weak-subjectivity checkpoint (0x...).
# If omitted for non-local networks, the Nixfied Helios service will derive one at start time.
#HELIOS_CHECKPOINT=0x...

# Optional websocket endpoint (useful for subscription-based tools).
ETHEREUM_MAINNET_RPC_WSS=wss://ethereum-rpc.publicnode.com

