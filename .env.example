# Example Ethereum mainnet RPC config for local development.
#
# Copy to `.env` (which is gitignored) and adjust as needed.

# Runtime-only live capability config. Keep RPC URLs, auth, keystore paths, and unlock files
# in a local untracked file referenced here.
MFM_RUNTIME_CONFIG_FILE=./runtime.local.toml

# Optional websocket endpoint (useful for subscription-based tools).
ETHEREUM_MAINNET_RPC_WSS=wss://ethereum-rpc.publicnode.com
